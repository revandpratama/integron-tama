// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  // output = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["integron"]
}

enum PartnerStatus {
  DRAFT
  ONBOARDING
  LIVE
  MAINTENANCE
  SUSPENDED

  @@schema("integron")
}

enum BoardStage {
  INITIATION
  KICKOFF_SETUP
  DEV_CONFIG
  TESTING_VALIDATION
  QA_REVIEW
  PARTNER_REVISION
  BLOCKED_WAITING
  PRE_PRODUCTION
  PRODUCTION_READY
  DEPLOYED
  POST_DEPLOYMENT
  DONE
  ARCHIVED

  @@schema("integron")
}

enum IntegrationType {
  INBOUND
  OUTBOUND
  HYBRID

  @@schema("integron")
}

enum Complexity {
  LOW
  MEDIUM
  HARD

  @@schema("integron")
}

enum TrafficLight {
  HEALTHY
  DEGRADED
  CRITICAL

  @@schema("integron")
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  status            PartnerStatus
  boardStage        BoardStage?      @default(INITIATION)
  integrationType   IntegrationType  @default(INBOUND)
  complexity        Complexity       @default(MEDIUM)
  trafficLight      TrafficLight     @default(HEALTHY)
  
  // JSON array of objects: { status: TrafficLight, comment: string, timestamp: string }
  trafficComments   Json             @default("[]")
  
  // Storing the checked states of specific board tasks.
  // Example: {"INITIATION": {"Email Partner Documentation": true}}
  boardTasks        Json             @default("{}")
  
  // Doc Status tracking (JSON)
  docStatus         Json             @default("{\"sit\": \"PENDING\", \"reconcile\": \"PENDING\", \"devsite\": \"PENDING\"}")
  
  notes             String?  // [NEW] Added for Kanban notes

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  kanbanOrder Int      @default(0) // [NEW] Persist manual card ordering in columns
  
  integratorId   String?  @map("integrator_id")
  integrator     User?    @relation("PartnerIntegrators", fields: [integratorId], references: [id], onDelete: SetNull)
  
  @@map("partners")
  @@schema("integron")
  
  people    Person[]
  features  Feature[]  // many-to-many with Feature
}

enum FeatureCategory {
  SNAP
  NON_SNAP
  @@schema("integron")
}

model Feature {
  id               String          @id @default(cuid())
  name             String
  category         FeatureCategory
  
  // Technical Specs (Arrays as per requirement)
  apigeeProducts   String[]
  apigeeTraceProxies String[]
  
  notes            String?

  // Relationships
  contactPerson   Person? @relation(fields: [contactPersonId], references: [id])
  contactPersonId String?
  partners        Partner[]  // many-to-many with Partner
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  
  @@schema("integron")
  @@map("features")
}

model Person {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  role      String
  notes     String?

  // Relationships
  partners  Partner[]
  features  Feature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("people")
  @@schema("integron")
}

model KnowledgeNote {
  id        String   @id @default(cuid())
  title     String
  content   String
  tags      String[]
  isPinned  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("knowledge_notes")
  @@schema("integron")
}

enum ReminderLevel {
  Info
  Important
  Critical

  @@schema("integron")
}

model Reminder {
  id          String   @id @default(cuid())
  title       String
  description String?
  scheduledAt DateTime
  level       ReminderLevel @default(Info)
  isCompleted Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reminders")
  @@schema("integron")
}

enum Role {
  USER
  ADMIN
  @@schema("integron")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  role          Role      @default(USER)
  isApproved    Boolean   @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
  @@schema("integron")

  todos         Todo[]
  activityLogs  ActivityLog[]
  integratedPartners Partner[] @relation("PartnerIntegrators")
}

model Todo {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  isCompleted Boolean  @default(false)
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("todos")
  @@schema("integron")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  actionType  String   @map("action_type")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
  @@schema("integron")
}
